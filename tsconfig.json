{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    // Node's --experimental-strip-types requires explicit .ts extensions on
    // relative imports, which TypeScript rejects unless this is enabled.
    // It lets the pure-logic modules run as tests on Linux with no build step.
    "allowImportingTsExtensions": true,
    "noEmit": true
  }
}
